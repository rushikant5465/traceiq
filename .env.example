# Copy to .env.development / .env.production and set your PayPal client IDs.
# Sandbox vs live is determined by which client ID you paste here (from the
# Developer Dashboard), not by a separate “sandbox URL” in this app.
VITE_PAYPAL_CLIENT_ID=

# Optional sanity check: PayPal’s public demo client id (wallet flow only).
# If checkout works with `test` but not your sandbox id, the problem is in
# the Developer Dashboard app / account setup, not this UI code.
# VITE_PAYPAL_CLIENT_ID=test
